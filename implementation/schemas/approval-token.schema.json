{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/eaap/schemas/approval-token.schema.json",
  "title": "EAAP Approval Token",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_token_id",
    "request_id",
    "execution_plan_id",
    "risk_tier",
    "approver",
    "approved_actions",
    "issued_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "approval_token_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "Tier 2",
        "Tier 3"
      ]
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approved_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "used",
        "expired",
        "revoked"
      ]
    }
  }
}
